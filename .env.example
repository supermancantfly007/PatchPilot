# API and web
PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Product-state repository. Unset PATCHPILOT_DATABASE_URL to use local PGlite under PATCHPILOT_DATA_DIR.
PATCHPILOT_DATA_DIR=./data
PATCHPILOT_DATABASE_URL=
PATCHPILOT_TEST_DATABASE_URL=

# Optional repo config. Defaults to .patchpilot/config.yaml; env vars below override config values.
PATCHPILOT_CONFIG_PATH=.patchpilot/config.yaml

# Runner mode: auto or codex. Both require the Codex CLI and a git workspace.
PATCHPILOT_RUNNER=auto

# Worker dispatcher
PATCHPILOT_API_BASE_URL=http://localhost:4000
PATCHPILOT_WORKER_INTERVAL_MS=5000
PATCHPILOT_WORKER_ONCE=false

# Temporal workflow engine. Requires a local Temporal server, for example compose service `temporal`.
PATCHPILOT_TEMPORAL_ADDRESS=localhost:7233
PATCHPILOT_TEMPORAL_NAMESPACE=default
PATCHPILOT_TEMPORAL_TASK_QUEUE=patchpilot-td-204

# OpenTelemetry. Disabled by default; set PATCHPILOT_OTEL_ENABLED=true and point OTLP HTTP at a local collector.
PATCHPILOT_OTEL_ENABLED=false
PATCHPILOT_OTEL_EXPORTER=otlp
PATCHPILOT_OTEL_SERVICE_NAME=patchpilot-api
PATCHPILOT_OTEL_EXPORT_INTERVAL_MS=500
PATCHPILOT_OTEL_METRIC_INTERVAL_MS=1000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Codex runner. These are read by the API process because runner work is embedded there.
# Target git repository to develop. Defaults to the repo containing .patchpilot/config.yaml, or the API cwd.
PATCHPILOT_REPOSITORY_ROOT=.
PATCHPILOT_WORKSPACE_ROOT=.patchpilot/worktrees
PATCHPILOT_TEST_COMMAND="pnpm -r --if-present test"
PATCHPILOT_CODEX_TIMEOUT_MS=600000
PATCHPILOT_TEST_TIMEOUT_MS=120000
PATCHPILOT_MAX_REPAIR_ATTEMPTS=1
PATCHPILOT_CODEX_SANDBOX=workspace-write
PATCHPILOT_CODEX_BYPASS=false
PATCHPILOT_CONTAINER_SANDBOX_ENABLED=false
PATCHPILOT_CONTAINER_SANDBOX_RUNTIME=auto
PATCHPILOT_CONTAINER_SANDBOX_IMAGE=node:24-alpine
PATCHPILOT_CONTAINER_SANDBOX_CPUS=2
PATCHPILOT_CONTAINER_SANDBOX_MEMORY_MB=4096
PATCHPILOT_CONTAINER_SANDBOX_WORKSPACE_DISK_MB=8192
PATCHPILOT_CONTAINER_SANDBOX_TMPFS_MB=256
PATCHPILOT_CONTAINER_SANDBOX_PIDS_LIMIT=512
PATCHPILOT_EGRESS_POLICY_ENABLED=true
PATCHPILOT_EGRESS_ALLOWED_HOSTS=github.com,api.github.com,codeload.github.com,objects.githubusercontent.com,raw.githubusercontent.com,github-releases.githubusercontent.com,npm.pkg.github.com,registry.npmjs.org,registry.yarnpkg.com,pypi.org,files.pythonhosted.org,rubygems.org,crates.io,index.crates.io,static.crates.io,proxy.golang.org,sum.golang.org,api.openai.com,auth.openai.com,chatgpt.com,*.openai.com,*.oaistatic.com
PATCHPILOT_EGRESS_ALLOW_GIT_REMOTES=true
PATCHPILOT_EGRESS_PROXY_IMAGE=node:24-alpine
PATCHPILOT_EGRESS_PROXY_PORT=3128
# Logical fallback for non-sandbox proxy tests; sandbox source logs are private sidecar-only files.
PATCHPILOT_EGRESS_AUDIT_LOG_PATH=.patchpilot/egress-audit.jsonl
PATCHPILOT_SECRET_BROKER_ENABLED=true
# JSON array of explicit dev/CI token grants, for example:
# [{"id":"github-ci-token","envVar":"GITHUB_TOKEN","sourceEnv":"PATCHPILOT_CI_GITHUB_TOKEN","environment":"ci"}]
PATCHPILOT_SECRET_BROKER_ALLOWED_SECRETS=[]
# Example source env for the grant above; keep unset unless needed for a dev/CI run.
PATCHPILOT_CI_GITHUB_TOKEN=
PATCHPILOT_PREVIEW_URL=http://localhost:3000

# Pull request adapter. Defaults to local records; set provider=github to push branches and create/update real PRs.
PATCHPILOT_PR_PROVIDER=local
PATCHPILOT_GITHUB_OWNER=
PATCHPILOT_GITHUB_REPO=
PATCHPILOT_GITHUB_REMOTE=origin
# Optional fork owner for source branches; leave empty to use PATCHPILOT_GITHUB_OWNER.
PATCHPILOT_GITHUB_HEAD_OWNER=
# Name of the env var that holds the GitHub token used by the API process.
PATCHPILOT_GITHUB_TOKEN_ENV=PATCHPILOT_GITHUB_TOKEN
PATCHPILOT_GITHUB_TOKEN=
# GitHub auth mode: token or app. App mode mints installation-scoped tokens.
PATCHPILOT_GITHUB_AUTH_MODE=token
PATCHPILOT_GITHUB_APP_ID=
PATCHPILOT_GITHUB_APP_PRIVATE_KEY_ENV=PATCHPILOT_GITHUB_APP_PRIVATE_KEY
PATCHPILOT_GITHUB_APP_PRIVATE_KEY=
PATCHPILOT_GITHUB_APP_PRIVATE_KEY_PATH=
PATCHPILOT_GITHUB_INSTALLATION_ID=
PATCHPILOT_GITHUB_WEBHOOK_SECRET_ENV=PATCHPILOT_GITHUB_WEBHOOK_SECRET
PATCHPILOT_GITHUB_WEBHOOK_SECRET=
# Optional GitHub Enterprise REST API base URL, for example https://github.example.com/api/v3.
PATCHPILOT_GITHUB_API_BASE_URL=
PATCHPILOT_GITHUB_PUSH_TIMEOUT_MS=30000

# Optional real GitHub fixture integration for @patchpilot/pull-request-adapter tests.
# Keep disabled unless PATCHPILOT_GITHUB_OWNER/REPO/TOKEN point at a disposable fixture repo.
PATCHPILOT_GITHUB_FIXTURE=0
PATCHPILOT_GITHUB_FIXTURE_WORKSPACE=
PATCHPILOT_GITHUB_BASE_BRANCH=main

# Artifact store. Use local_fs by default; set PATCHPILOT_ARTIFACT_STORE=s3 for MinIO/S3-compatible storage.
PATCHPILOT_ARTIFACT_STORE=local_fs
PATCHPILOT_ARTIFACT_ROOT=.patchpilot/artifacts
PATCHPILOT_ARTIFACT_S3_ENDPOINT=http://localhost:9000
PATCHPILOT_ARTIFACT_S3_REGION=us-east-1
PATCHPILOT_ARTIFACT_S3_BUCKET=patchpilot
PATCHPILOT_ARTIFACT_S3_ACCESS_KEY_ID=patchpilot
PATCHPILOT_ARTIFACT_S3_SECRET_ACCESS_KEY=patchpilot123
PATCHPILOT_ARTIFACT_S3_FORCE_PATH_STYLE=true
PATCHPILOT_ARTIFACT_S3_PREFIX=patchpilot

# Optional Docker middleware. Set PATCHPILOT_DATABASE_URL to this Postgres URL when you want the API to use compose Postgres.
TEMPORAL_VERSION=1.29.6
DATABASE_URL=postgresql://patchpilot:patchpilot@localhost:5432/patchpilot
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=patchpilot
S3_SECRET_ACCESS_KEY=patchpilot123
S3_BUCKET=patchpilot
