{
  "name": "@patchpilot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dispatch": "./src/dispatch.ts",
    "./temporal": "./src/temporal.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:temporal": "tsx watch src/temporal.ts",
    "start": "tsx src/index.ts",
    "start:temporal": "tsx src/temporal.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint:workspace": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@patchpilot/contracts": "workspace:*",
    "@patchpilot/domain": "workspace:*",
    "@patchpilot/policy": "workspace:*",
    "@patchpilot/telemetry": "workspace:*",
    "@patchpilot/workflows": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
