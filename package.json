{
  "name": "patchpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm dev:team",
    "dev:team": "concurrently -n api,web,worker -c blue,green,magenta \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:api": "pnpm --filter @patchpilot/api dev",
    "dev:web": "pnpm --filter @patchpilot/web dev",
    "dev:worker": "pnpm --filter @patchpilot/worker dev",
    "dev:reset": "node scripts/reset-dev-data.mjs",
    "cli": "pnpm --filter @patchpilot/cli start",
    "openapi:generate": "tsx scripts/generate-openapi.mjs",
    "openapi:check": "tsx scripts/generate-openapi.mjs --check",
    "events:generate": "tsx scripts/generate-event-schema.mjs",
    "events:check": "tsx scripts/generate-event-schema.mjs --check",
    "e2e:cli": "node scripts/e2e-cli.mjs",
    "e2e:approvals": "node scripts/e2e-approvals.mjs",
    "e2e:budget": "node scripts/e2e-budget-governance.mjs",
    "e2e:failure-defect": "node scripts/e2e-failure-defect.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "e2e:team": "node scripts/e2e-team-worker.mjs",
    "e2e:bug": "node scripts/e2e-bug-worker.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run //#lint:repo lint:workspace",
    "lint:repo": "eslint eslint.config.mjs scripts --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "playwright-core": "^1.60.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.15"
  }
}
