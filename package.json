{
  "name": "patchpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm dev:team",
    "dev:team": "concurrently -n api,web,worker -c blue,green,magenta \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:api": "pnpm --filter @patchpilot/api dev",
    "dev:web": "pnpm --filter @patchpilot/web dev",
    "dev:worker": "pnpm --filter @patchpilot/worker dev",
    "dev:reset": "node scripts/reset-dev-data.mjs",
    "cli": "pnpm --filter @patchpilot/cli start",
    "openapi:generate": "tsx scripts/generate-openapi.mjs",
    "openapi:check": "tsx scripts/generate-openapi.mjs --check",
    "events:generate": "tsx scripts/generate-event-schema.mjs",
    "events:check": "tsx scripts/generate-event-schema.mjs --check",
    "k8s:validate": "node scripts/validate-k8s-worker-pool.mjs",
    "sandbox:poc": "node scripts/poc-sandbox-runtime.mjs",
    "e2e:cli": "node scripts/e2e-cli.mjs",
    "e2e:approvals": "node scripts/e2e-approvals.mjs",
    "e2e:rbac-auth": "tsx scripts/e2e-rbac-auth.mjs",
    "e2e:budget": "node scripts/e2e-budget-governance.mjs",
    "e2e:failure-defect": "node scripts/e2e-failure-defect.mjs",
    "e2e:acceptance-gate": "node scripts/e2e-acceptance-gate.mjs",
    "e2e:professional-governance": "node scripts/e2e-professional-governance.mjs",
    "e2e:otel": "node scripts/e2e-otel.mjs",
    "e2e:metrics": "node scripts/e2e-metrics.mjs",
    "e2e:pi-fake": "node scripts/e2e-pi-fake.mjs",
    "e2e:pi-rpc-fake": "tsx scripts/e2e-pi-rpc-fake.ts",
    "e2e:pi-real-smoke": "node scripts/e2e-pi-real-smoke.mjs",
    "e2e:audit-export": "node scripts/e2e-audit-export.mjs",
    "e2e:release-rollback": "tsx scripts/e2e-release-rollback-approval.mjs",
    "e2e:external-issue": "node scripts/e2e-external-issue-sync.mjs",
    "e2e:github-app": "tsx scripts/e2e-github-app.mjs",
    "e2e:multi-repo": "tsx scripts/e2e-multi-repo.mjs",
    "e2e:egress": "tsx scripts/e2e-egress-allowlist.mjs",
    "e2e:command-wrapper": "tsx scripts/e2e-command-wrapper.mjs",
    "e2e:temporal": "tsx scripts/e2e-temporal.mjs",
    "e2e:codex-simple": "node scripts/e2e-codex-simple-project.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "e2e:team": "node scripts/e2e-team-worker.mjs",
    "e2e:bug": "node scripts/e2e-bug-worker.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run //#lint:repo lint:workspace",
    "lint:repo": "eslint eslint.config.mjs scripts --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "playwright-core": "^1.60.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.15"
  }
}
